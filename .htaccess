RewriteEngine On

# 1. Hapus ekstensi .php jika diakses langsung oleh user
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# 2. Arahkan URL tanpa ekstensi ke file .php asli di latar belakang
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]
